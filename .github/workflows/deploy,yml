name: CI/CD Pipeline

on:
  push:
    branches:
      - main                            # triggers on every push to main

jobs:
  build-and-push:
    name: Build and Push Docker Image
    runs-on: ubuntu-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v3

    - name: Login to Docker Hub
      uses: docker/login-action@v2
      with:
        username: ${{ secrets.DOCKER_USERNAME }}
        password: ${{ secrets.DOCKER_PASSWORD }}

    - name: Build and push Docker image
      run: |
        docker build -t arbin09/kube-devops-app:latest .
        docker build -t arbin09/kube-devops-app:${{ github.sha }} .
        docker push arbin09/kube-devops-app:latest
        docker push arbin09/kube-devops-app:${{ github.sha }}

    - name: Print success message
      run: |
        echo "✅ Image built and pushed successfully!"
        echo "Image: arbin09/kube-devops-app:${{ github.sha }}"